---
import {
  property, monthly, hero, proofBar, location, mechanism, specGroups,
  techProofs, techNote, planPoints, comparison, outline, outlineNote,
  images, faqs, afterSubmit, company,
} from "../../../data/brains-house-odaka";
import BrainsImage from "../../../components/brains-image.astro";
import "../../../styles/brains-lp.css";

const title = `${property.fullName}｜${property.address}の平屋モデルハウス`;
const description =
  "愛知県半田市大高町の平屋モデルハウス。土地109坪、中庭とウッドデッキ、駐車場8台。太陽光16.8kW搭載のZEH住宅、耐震等級3。6,160万円（税込）、2026年9月完成。";
const telHref = `tel:${company.tel.replace(/[^0-9]/g, "")}`;
---
<!DOCTYPE html>
<html lang="ja" data-v="a">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <script is:inline>
    (function () {
      var v = new URLSearchParams(location.search).get("v");
      if (v === "b") document.documentElement.dataset.v = "b";
    })();
  </script>
</head>
<body>

<header class="bar">
  <div class="bar-in">
    <a class="logo" href="/brains-house/odaka/">
      <strong>BRAINS</strong><span>イシンプレミアム大高</span>
    </a>
    <div class="bar-cta">
      <a class="tel" href={telHref}>
        <span class="tel-num">{company.tel}</span>
        <span class="tel-hours">{company.telHours}</span>
      </a>
      <a class="btn btn-primary btn-sm" href="#reserve">見学予約</a>
    </div>
  </div>
</header>

<main>

  <!-- ═══ 要素4：ファーストビュー ─ ここで60%が決まる ═══ -->
  <section class="hero">
    <div class="hero-in">
      <div class="hero-copy">
        <p class="eyebrow">{hero.a.eyebrow}</p>

        <h1 class="hero-h">
          <span class="var-a">{hero.a.headline[0]}<br /><em>{hero.a.headline[1]}</em></span>
          <span class="var-b">{hero.b.headline[0]}<br /><em>{hero.b.headline[1]}</em></span>
        </h1>

        <p class="hero-sub">
          <span class="var-a">{hero.a.subhead}</span>
          <span class="var-b">{hero.b.subhead}</span>
        </p>

        <!-- 物件を探している人は「どこ・いくら・どんな家」が分からないと読み進めてくれない -->
        <dl class="hero-facts">
          <div><dt>価格</dt><dd>{property.price}<small>{property.priceNote}</small></dd></div>
          <div><dt>間取り</dt><dd>{property.layout}</dd></div>
          <div><dt>土地</dt><dd>{property.land}</dd></div>
          <div><dt>建物</dt><dd>{property.building}</dd></div>
          <div><dt>所在地</dt><dd>{property.address}</dd></div>
          <div><dt>完成</dt><dd>{property.completion}</dd></div>
        </dl>

        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="#reserve">見学を予約する</a>
          <a class="btn btn-ghost btn-lg" href="#monthly">月々の支払いを見る</a>
        </div>
        <p class="hero-micro">入力は30秒ほど。しつこい営業はいたしません。</p>
      </div>

      <figure class="hero-visual">
        <div class="var-a">
          <BrainsImage src={images.hero.a.src} alt={images.hero.a.alt} note={images.hero.a.note} ratio="4 / 3" eager={true} />
        </div>
        <div class="var-b">
          {/* B案は既定では非表示。eager にすると A案しか見ない人にも余計に読み込まれるので lazy にする。 */}
          <BrainsImage src={images.hero.b.src} alt={images.hero.b.alt} note={images.hero.b.note} ratio="4 / 3" />
        </div>
      </figure>
    </div>
  </section>

  <!-- ═══ 要素5：社会的証明を早めに置く ═══ -->
  <section class="proof">
    <ul class="proof-list">
      {proofBar.map((p) => (
        <li><strong>{p.value}</strong><span>{p.label}</span></li>
      ))}
    </ul>
  </section>

  <!-- ═══════════════════════════════════════════════
       月々のお支払い ─ このLPの背骨
       合計額だけを単独で見せない。内訳と試算条件を必ず同じ画面に置く。
       売電収入と減税を差し引いた数字は、内訳を隠すと優良誤認になる。
       ═══════════════════════════════════════════════ -->
  <section class="sec sec-monthly" id="monthly">
    <div class="wrap narrow">
      <p class="kicker">Monthly payment</p>
      <h2>6,160万円の平屋の、月々。</h2>
      <p class="lead">
        16.8kWの太陽光が毎月電気を生みます。売電収入と住宅ローン減税を差し引くと、
        月々のお支払いはこうなります。
      </p>

      <div class="pay">
        <ul class="pay-rows">
          {monthly.rows.map((r) => (
            <li class={r.sign}>
              <span class="pay-label">{r.label}</span>
              <span class="pay-value">
                {r.sign === "minus" ? "−" : "＋"}{r.value}
              </span>
            </li>
          ))}
        </ul>
        <div class="pay-total">
          <span class="pay-total-label">月々の合計</span>
          <strong class="pay-total-value">{monthly.total}</strong>
        </div>
        <p class="pay-cond">試算条件：{monthly.conditions}</p>
      </div>

      <p class="note">{monthly.disclaimer}</p>
    </div>
  </section>

  <!-- ═══ 新PASONA ─ P：問題提起（煽らず、事実を置く）═══ -->
  <section class="sec sec-problem">
    <div class="wrap narrow">
      <p class="kicker">Problem</p>
      <h2>広い平屋は、高いから諦める。</h2>
      <p>
        平屋がいい。庭がほしい。車も何台か置きたい。
        そう思って探しはじめても、たいていは価格を見て諦めることになります。
      </p>
      <p>
        平屋は同じ床面積でも土地を多く使うぶん、二階建てより高くなります。
        109坪の敷地となれば、なおさらです。
      </p>
      <p>
        けれど、比べるべきは物件価格ではなく、<strong>毎月いくら出ていくか</strong>です。
        住宅ローンと光熱費を払い、太陽光が電気を生む。その差引きで見たとき、
        この家の月々は<strong>{monthly.total}</strong>になります。
      </p>
    </div>
  </section>

  <!-- ═══ 新PASONA ─ A：親近感（煽りではなく共感）═══ -->
  <section class="sec sec-affinity">
    <div class="wrap narrow">
      <p class="kicker">Affinity</p>
      <h2>「妥協した家に、30年住みたくない」</h2>
      <p>
        私たちチタコーポレーションは1995年から、半田を中心に愛知で住まいのご相談を
        お受けしてきました。土地探しも、賃貸も、売却も、注文住宅も、同じ会社でお受けしています。
      </p>
      <p>
        そのなかで、家を建て終えた方から何度もうかがってきた言葉があります。
        「あのとき、もう少しだけ広くしておけばよかった」。
        逆に、広さを取って後悔したという話は、ほとんど聞きません。
      </p>
      <p>
        <strong>この家は、その「もう少し」を最初から入れてあります。</strong>
        中庭、ウッドデッキ、土間収納、ファミリークローゼット、8台分の駐車場。
        そして、それを月々{monthly.total}で持てるようにするための、16.8kWの太陽光です。
      </p>
    </div>
  </section>

  <!-- ═══ 新PASONA ─ S：解決策 ＋ O：オファー（メカニズム）═══ -->
  <section class="sec sec-solution">
    <div class="wrap">
      <p class="kicker">Solution &amp; Offer</p>
      <h2>なぜ、月々がこの金額になるのか。</h2>
      <p class="lead">「高性能だから」では説明になりません。仕組みは3つです。</p>

      <ol class="mech">
        {mechanism.map((m) => (
          <li>
            <span class="mech-step">{m.step}</span>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
          </li>
        ))}
      </ol>

      <div class="solution-shot">
        <BrainsImage src={images.solution.src} alt={images.solution.alt} note={images.solution.note} ratio="21 / 9" />
      </div>

      <div class="equation">
        <p>大きくつくって売り、昼に沸かし、逃がさない。</p>
        <p class="equation-out">
          だから、6,160万円の平屋が月々<em>{monthly.total}</em>になります。
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ 間取り ═══ -->
  <section class="sec sec-plan">
    <div class="wrap">
      <p class="kicker">Floor plan</p>
      <h2>{property.layout}</h2>
      <p class="lead">{property.structure}・{property.building}。階段のない、ワンフロアの暮らし。</p>

      <div class="plan-grid">
        <div class="plan-visual">
          <BrainsImage src={images.plan.src} alt={images.plan.alt} note={images.plan.note} ratio="438 / 797" className="plan-img" />
        </div>
        <ul class="plan-list">
          {planPoints.map((pt) => (
            <li><h3>{pt.title}</h3><p>{pt.body}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ 室内ギャラリー ═══ -->
  <section class="sec sec-gallery">
    <div class="wrap">
      <p class="kicker">Interior</p>
      <h2>家具まで、決まっています。</h2>
      <p class="lead">
        ACTUSのコーディネーターが、この家に合わせて選んだ状態でご覧いただけます。
      </p>
      <div class="gallery">
        {images.gallery.map((g) => (
          <figure class="shot">
            <BrainsImage src={g.src} alt={g.alt} note={g.note} ratio="4 / 3" />
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 設備一覧 ═══ -->
  <section class="sec sec-facility">
    <div class="wrap">
      <p class="kicker">Facilities</p>
      <h2>標準装備</h2>
      <p class="lead">オプションではありません。あとから足す費用はかかりません。</p>

      <div class="fac-grid">
        {specGroups.map((g) => (
          <div class="fac">
            <h3>{g.title}</h3>
            <ul>
              {g.items.map((it) => (<li>{it}</li>))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ 設備の裏づけ ─ メーカー資料。数値の出典を必ず明示する ═══ -->
  <section class="sec sec-tech">
    <div class="wrap">
      <p class="kicker">Technology</p>
      <h2>「標準装備」の中身。</h2>
      <p class="lead">名前を並べるだけでは伝わりません。何がどう効くのかを見てください。</p>

      <div class="tech-list">
        {techProofs.map((t) => (
          <article class="tech">
            <div class="tech-visual">
              <img src={t.image.src} alt={t.image.alt} loading="lazy" decoding="async" />
            </div>
            <div class="tech-body">
              <h3>{t.title}</h3>
              <p class="tech-maker">{t.maker}</p>
              <p>{t.body}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="note">{techNote}</p>
    </div>
  </section>

  <!-- ═══ 差別化 ─ 項目別で示す ═══ -->
  <section class="sec sec-compare">
    <div class="wrap">
      <p class="kicker">Difference</p>
      <h2>一般的な新築と、何がどう違うのか。</h2>
      <p class="lead">「高性能」ではなく、項目で比べてください。</p>

      <div class="table-scroll">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">項目</th>
              {comparison.columns.map((c, i) => (
                <th scope="col" class={i === 0 ? "col-own" : ""}>{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {comparison.rows.map((r) => (
              <tr>
                <th scope="row">{r.item}</th>
                {r.values.map((v, i) => (
                  <td class={i === 0 ? "col-own" : ""}>{v}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        右列は一般的な新築住宅の仕様の傾向をまとめたものです。各社の実際の仕様とは異なる場合があります。
      </p>
    </div>
  </section>

  <!-- ═══ 立地 ─ 弱点も書く。隠せば現地で失望される ═══ -->
  <section class="sec sec-location">
    <div class="wrap">
      <p class="kicker">Location</p>
      <h2>{property.address}</h2>
      <p class="lead">{location.lead}</p>

      <div class="loc-grid">
        <ul class="loc-list">
          {location.points.map((pt) => (
            <li><h3>{pt.title}</h3><p>{pt.body}</p></li>
          ))}
        </ul>
        <div class="loc-visual">
          <BrainsImage src={images.location.src} alt={images.location.alt} note={images.location.note} ratio="4 / 3" />
        </div>
      </div>
      <p class="note">{location.note}</p>
    </div>
  </section>

  <!-- ═══ 新PASONA ─ N：絞り込み（架空の締切は作らない）═══ -->
  <section class="sec sec-narrow">
    <div class="wrap narrow">
      <p class="kicker">Narrow down</p>
      <h2>この家は、1棟だけです。</h2>
      <p>
        モデルハウスですから、同じ家はもうありません。中庭の位置も、109坪の敷地も、
        8台分の駐車場も、この一軒だけのものです。
      </p>
      <p>
        {property.completion}。急かすつもりはありません。
        ただ、写真では平屋の広さも中庭の抜けも伝わりません。
        <strong>見てから考えるほうが、後悔は少ないはずです。</strong>
      </p>
    </div>
  </section>

  <!-- ═══ FAQ ─ 出口の手前で不安を潰す ═══ -->
  <section class="sec sec-faq">
    <div class="wrap narrow">
      <p class="kicker">FAQ</p>
      <h2>ご不安な点</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ═══ 要素4：コンバージョンポイント ─ ここで20%が決まる ═══ -->
  <section class="sec sec-reserve" id="reserve">
    <div class="wrap narrow">
      <p class="kicker">Action</p>
      <h2>30秒で、見学予約。</h2>

      <ol class="after">
        {afterSubmit.map((a) => (
          <li>
            <span class="after-step">{a.step}</span>
            <strong>{a.label}</strong>
            <span class="after-body">{a.body}</span>
          </li>
        ))}
      </ol>

      <form
        class="form"
        name="brains-odaka-reserve"
        method="POST"
        action="/brains-house/thanks"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="brains-odaka-reserve" />
        <input type="hidden" name="物件" value="【モデルハウス】イシンプレミアム大高" />
        <input type="hidden" name="variant" id="variant-field" value="a" />
        <p class="hp"><label>この欄は入力しないでください <input name="bot-field" /></label></p>

        <!-- 分岐を先頭に。答えた勢いのまま氏名入力へ進んでもらう -->
        <fieldset class="fs">
          <legend>ご希望をお選びください</legend>
          <div class="choices">
            <label class="choice">
              <input type="radio" name="希望" value="見学予約" checked />
              <span><strong>現地を見学したい</strong><small>所要約60分</small></span>
            </label>
            <label class="choice">
              <input type="radio" name="希望" value="資料請求" />
              <span><strong>まず資料を見たい</strong><small>間取り図・設備・価格</small></span>
            </label>
            <label class="choice">
              <input type="radio" name="希望" value="資金相談" />
              <span><strong>資金の相談をしたい</strong><small>ローン・住み替え</small></span>
            </label>
          </div>
        </fieldset>

        <label class="f">
          <span class="f-label">お名前 <b class="req">必須</b></span>
          <input type="text" name="お名前" required autocomplete="name" placeholder="山田 太郎" />
        </label>

        <label class="f">
          <span class="f-label">お電話番号 <b class="req">必須</b></span>
          <input type="tel" name="電話番号" required autocomplete="tel" inputmode="tel" placeholder="09000000000" />
        </label>

        <label class="f">
          <span class="f-label">メールアドレス <b class="opt">任意</b></span>
          <input type="email" name="メールアドレス" autocomplete="email" placeholder="example@example.com" />
        </label>

        <label class="f">
          <span class="f-label">ご希望の日程 <b class="opt">任意</b></span>
          <input type="text" name="希望日程" placeholder="例）今週末の午後、平日の夕方 など" />
        </label>

        <label class="f">
          <span class="f-label">ご質問・ご要望 <b class="opt">任意</b></span>
          <textarea name="ご要望" rows="3" placeholder="資金のこと、今のお住まいの売却のことなど"></textarea>
        </label>

        <!-- 不安を、送信ボタンの真上で潰す -->
        <p class="assure">
          いただいた内容は物件のご案内以外には使用しません。<br />
          <strong>その場での契約のお話や、しつこいご連絡はいたしません。</strong>
        </p>

        <button type="submit" class="btn btn-primary btn-lg btn-block">この内容で送信する</button>
      </form>

      <div class="or">
        <span>お電話でも承ります</span>
        <a class="tel-big" href={telHref}>{company.tel}</a>
        <small>{company.telHours}</small>
      </div>
    </div>
  </section>

  <!-- ═══ 物件概要（宅建業法上の表示事項）═══ -->
  <section class="sec sec-outline">
    <div class="wrap narrow">
      <p class="kicker">Outline</p>
      <h2>物件概要</h2>
      <dl class="outline">
        {outline.map((o) => (
          <div class="outline-row"><dt>{o.label}</dt><dd>{o.value}</dd></div>
        ))}
      </dl>
      <p class="note">{outlineNote}</p>
    </div>
  </section>

</main>

<footer class="foot">
  <div class="wrap">
    <p class="foot-brand"><strong>BRAINS</strong> ブレインズの家</p>
    <p>{company.name}</p>
    <p class="foot-areas">{company.address}</p>
    <p class="foot-license">宅地建物取引業免許　{company.license}</p>
    <p class="foot-areas"><a href="/brains-house/">ブレインズの家（半田・知多・阿久比）はこちら</a></p>
  </div>
</footer>

<div class="sticky-cta">
  <a class="btn btn-ghost" href={telHref}>電話する</a>
  <a class="btn btn-primary" href="#reserve">見学予約</a>
</div>

<script is:inline>
  (function () {
    var f = document.getElementById("variant-field");
    if (f) f.value = document.documentElement.dataset.v || "a";
  })();
</script>

<style is:global>
  /* 大高LP固有のスタイル。共通分は src/styles/brains-lp.css */

  .hero-facts {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 0 1.5rem; margin: 0 0 1.8rem;
    padding: 1rem 1.3rem; background: var(--white);
    border: 1px solid var(--line); border-radius: 6px;
  }
  .hero-facts > div { display: flex; gap: .8rem; align-items: baseline; padding: .35rem 0; }
  .hero-facts dt { font-size: .7rem; color: var(--muted); min-width: 3.2em; flex: none; letter-spacing: .06em; }
  .hero-facts dd { margin: 0; font-size: .85rem; font-weight: 700; }
  .hero-facts dd small { font-weight: 400; font-size: .72rem; color: var(--muted); margin-left: .2em; }

  /* 月々のお支払い ─ 合計だけを孤立させず、内訳と条件を同じ枠に入れる */
  .sec-monthly { background: var(--white); }
  .pay {
    margin: 2rem 0 0; padding: clamp(1.3rem, 3vw, 2rem);
    background: var(--bg-alt); border-radius: 8px; border: 1px solid var(--line);
  }
  .pay-rows { list-style: none; padding: 0; margin: 0; }
  .pay-rows li {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem; padding: .75rem 0; border-bottom: 1px solid var(--line);
  }
  .pay-label { font-size: .9rem; }
  .pay-value { font-family: var(--serif); font-size: 1.05rem; font-weight: 600; white-space: nowrap; }
  .pay-rows li.minus .pay-value { color: var(--accent); }
  .pay-total {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem; padding: 1.2rem 0 .6rem;
  }
  .pay-total-label { font-size: .95rem; font-weight: 700; }
  .pay-total-value {
    font-family: var(--serif); font-size: clamp(1.8rem, 5vw, 2.6rem);
    color: var(--amber); font-weight: 600; letter-spacing: -.01em;
  }
  .pay-cond { font-size: .76rem; color: var(--muted); margin: 0; padding-top: .6rem; border-top: 1px solid var(--line); }

  /* 間取り */
  .sec-plan { background: var(--bg-alt); }
  .plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start; margin-top: 2rem; }
  .plan-list { list-style: none; padding: 0; margin: 0; }
  .plan-list li { padding: 1rem 0; border-top: 1px solid var(--line); }
  .plan-list li:last-child { border-bottom: 1px solid var(--line); }
  .plan-list h3 { font-size: .98rem; margin: 0 0 .3rem; color: var(--accent-dark); }
  .plan-list p { font-size: .86rem; color: #46423d; margin: 0; }

  /* 設備一覧 */
  .fac-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2rem; }
  .fac { background: var(--white); border: 1px solid var(--line); border-radius: 6px; padding: 1.5rem; }
  .fac h3 { font-size: 1rem; margin: 0 0 .9rem; color: var(--accent); }
  .fac ul { list-style: none; padding: 0; margin: 0; }
  .fac li { font-size: .85rem; padding: .4rem 0; border-top: 1px solid var(--line); }
  .fac li:first-child { border-top: none; }

  /* 間取り図は縦長。枠いっぱいに引き伸ばさない */
  .plan-img { max-width: 420px; margin: 0 auto; background: var(--white); border: 1px solid var(--line); }

  /* 設備の裏づけ */
  .sec-tech { background: var(--white); }
  .tech-list { display: grid; gap: 1.2rem; margin-top: 2rem; }
  .tech {
    display: grid; grid-template-columns: 300px 1fr; gap: 1.8rem; align-items: center;
    background: var(--bg-alt); border: 1px solid var(--line); border-radius: 8px; overflow: hidden;
  }
  .tech-visual { background: var(--white); }
  .tech-visual img { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .tech-body { padding: 1.4rem 1.8rem 1.4rem 0; }
  .tech-body h3 { font-size: 1.05rem; margin: 0 0 .2rem; color: var(--accent-dark); }
  .tech-maker { font-size: .7rem; color: var(--muted); letter-spacing: .06em; margin: 0 0 .7rem; }
  .tech-body p { font-size: .88rem; color: #46423d; margin: 0; }

  /* 立地 */
  .sec-location { background: var(--white); }
  .loc-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 2.5rem; align-items: start; margin-top: 2rem; }
  .loc-list { list-style: none; padding: 0; margin: 0; }
  .loc-list li { padding: 1.2rem 0; border-top: 1px solid var(--line); }
  .loc-list li:last-child { border-bottom: 1px solid var(--line); }
  .loc-list h3 { font-size: 1rem; margin: 0 0 .4rem; color: var(--accent-dark); }
  .loc-list p { font-size: .88rem; color: #46423d; margin: 0; }

  /* 物件概要 */
  .sec-outline { background: var(--bg-alt); }
  .outline { margin: 2rem 0 0; }
  .outline-row { display: flex; gap: 1.2rem; padding: .8rem .2rem; border-top: 1px solid var(--line); font-size: .85rem; }
  .outline-row:last-child { border-bottom: 1px solid var(--line); }
  .outline dt { min-width: 9em; flex: none; color: var(--accent); font-weight: 700; }
  .outline dd { margin: 0; }

  @media (max-width: 860px) {
    .plan-grid, .loc-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .plan-visual, .loc-visual { order: -1; }
    .hero-facts { grid-template-columns: 1fr; }
    .fac-grid { grid-template-columns: 1fr; }
    .tech { grid-template-columns: 1fr; }
    .tech-body { padding: 1.2rem 1.4rem 1.5rem; }
    .outline-row { flex-direction: column; gap: .2rem; }
    .outline dt { min-width: 0; }
  }
</style>

</body>
</html>
